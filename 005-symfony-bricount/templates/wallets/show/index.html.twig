{% extends '_layouts/in_app.html.twig' %}

{% block title %}Portefeuille {{ wallet.label }}{% endblock %}

{% block content %}
    <h1>Portefeuille {{ wallet.label }} (Page {{ page }}/{{ maxPaginationPage }})</h1>
    <div style="margin: 20px 20px 50px 50px">
        <a class="pageButton" href="{{ path("wallets_edit",  {"uid": uid}) }}">
            Modifier Portefeuille
        </a>
    </div>
    <h2>Montant Total : {{ wallet.totalAmount / 100 }}</h2>
    <ul>
        {% for expense in expenses %}
            <li>
                 {{ expense.description }}  le {{ expense.createdDate | date('d/m/Y') }} : {{ expense.amount }}€
            </li>
        {% endfor %}
    </ul>

    <div class="pages">
        {% for i in 1..maxPaginationPage %}
            <a class="pageButton" href={{ path("wallets_show", {"uid": wallet.uid}) }}?page={{ i }}&limit={{ limit }}>{{ i }}</a>
        {% endfor %}
    </div>
{% endblock %}
