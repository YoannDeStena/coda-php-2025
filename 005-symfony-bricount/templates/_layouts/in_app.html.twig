{% extends 'base.html.twig' %}

{% block body%}
    <style>
        :root {
            background: #111111;
            color: white;
            font-family: Arial, sans-serif;
        }
        code {
            color: black
        }
        .active {
            background: lawngreen;
        }
        .active:hover {
            background: green;
        }
        .logout {
            background: none;
            color: #FF7070;
        }
        .logout:hover {
            background: red;
        }

        nav > ul {
            list-style-type: none;
            padding: 0;
            background-color: #333333;
            display: flex;
            margin: 0;
        }

        nav > ul > li > a {
            display: block;
            padding: 14px 35px;
            text-decoration: none;
            background: deepskyblue;
            transition: all 0.5s;
            color: black
        }

        nav > ul > li > a:hover {
            background-color: blue;
            color: white
        }
        .alert {
            background: red;
            border-radius: 5px;
        }

        .pages {
            display: flex;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .pageButton {
            background: deepskyblue;
            color: black;
            text-decoration: none;
            border-radius: 20px;
            padding: 20px;
            margin: 5px;
            transition: 0.5s all;
        }

        .pageButton:hover {
            background: blue;
            color: white;
        }
    </style>

    <div class="container">
        {# menu #}
        {% include '_components/menu.html.twig' %}
        {# messages flashes #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ message|raw }}
                </div>
            {% endfor %}
        {% endfor %}
        {# contenu #}
        {% block content %} {% endblock %}
    </div>
{% endblock %}
